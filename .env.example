# --- general ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- secrets: generate real values with `python scripts/init_env.py` -------
SECRET_KEY=
ENCRYPTION_KEY=

# --- DB Pulse internal MongoDB (metadata store) ----------------------------
INTERNAL_MONGO_URI=mongodb://127.0.0.1:27117
INTERNAL_DB_NAME=dbpulse_internal

# --- demo mode: the MONITORED MongoDB that receives the demo dataset --------
DEMO_MONGO_URI=mongodb://127.0.0.1:27118

# --- auth / limits ----------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- AI: works fully without a key (local rule-based mode) ------------------
# Set AI_PROVIDER=cohere and fill both values to enable Cohere explanations.
AI_PROVIDER=local
COHERE_API_KEY=
COHERE_MODEL=

# --- background work --------------------------------------------------------
# true: in-process scheduler (local dev). Docker uses Celery + Redis instead.
ENABLE_INPROCESS_SCHEDULER=true
SCHEDULER_TICK_S=15
CELERY_BROKER_URL=redis://localhost:6379/0
